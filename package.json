{
  "name": "task-tracker-kuliah",
  "version": "1.0.0",
  "private": true,
  "description": "Aplikasi CRUD tugas kuliah dengan Express, Prisma, dan Neon PostgreSQL.",
  "type": "module",
  "main": "server.ts",
  "scripts": {
    "start": "tsx server.ts",
    "dev": "tsx watch server.ts",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:seed": "prisma db seed"
  },
  "engines": {
    "node": ">=20.19"
  },
  "keywords": [
    "express",
    "crud",
    "javascript",
    "tugas-kuliah"
  ],
  "license": "MIT",
  "dependencies": {
    "@prisma/adapter-neon": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "tsx": "^4.23.15"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "prisma": "^7.10.1",
    "typescript": "^7.0.2"
  }
}
